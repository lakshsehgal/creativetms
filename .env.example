# ---- Supabase ----------------------------------------------------------
# Project Settings -> API. Both of these are safe in the browser; row-level
# security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_. Used for admin actions that
# must bypass RLS: inviting teammates and running the nightly scorecard roll-up.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Cron -------------------------------------------------------------
# Any long random string. Vercel Cron sends it as a bearer token so the
# scorecard endpoint cannot be triggered by the public internet.
CRON_SECRET=generate-a-long-random-string

# ---- Scorecard digest --------------------------------------------------
# The nightly email to admins and operators goes out through Resend, the same
# service already sending your sign-in codes. Leave blank and the roll-up
# still runs — only the email is skipped.
RESEND_API_KEY=re_your_key
SCORECARD_FROM_EMAIL=no-reply@neuroidmedia.com

# ---- Sign-in ------------------------------------------------------------
# How many digits the emailed code has. Must match Authentication -> Sign In /
# Providers -> Email -> "Email OTP Length" in the Supabase dashboard, because
# the login screen draws exactly this many boxes.
#
# Supabase will not go below 6 (the documented range is 6-10), so 6 is the
# shortest code this tool can ask anyone to type. Leave blank for 6.
NEXT_PUBLIC_OTP_LENGTH=6

# The email address that gets the `admin` role on first sign-in. Bootstraps
# the very first account; everyone after that is invited from the Team page.
NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAIL=you@yourcompany.com
